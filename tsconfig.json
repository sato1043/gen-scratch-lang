{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "types": [
      "node"
    ],
    "skipLibCheck": true,
    "strict": true,
    "noImplicitAny": true
  },
  "include": [
    "src/**/*.mjs",
    "src/**/*.ts",
    "tools/**/*.mjs",
    "tools/**/*.ts",
    "catalog/**/*.mjs",
    "catalog/**/*.ts",
    "types/**/*.d.ts",
    "test/**/*.mjs",
    "test/**/*.ts"
  ]
}
